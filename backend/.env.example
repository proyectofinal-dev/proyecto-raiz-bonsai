# Copiar como .env y completar. El .env real NUNCA se sube a GitHub.
PORT=3000

# Supabase → Project Settings → Database → Connection string → URI
# (usar la del "Session pooler", que funciona en redes IPv4 como la de Render)
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Clave para firmar los tokens del admin. Larga y aleatoria; generar una con:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# Asistente de IA. La key se obtiene gratis en https://aistudio.google.com
# Va SOLO aquí (backend): en el frontend quedaría expuesta en el navegador.
GEMINI_API_KEY=
# Opcional: modelo a usar (por defecto gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_MODEL_RESPALDO=gemini-flash-lite-latest   (se usa si el principal está saturado)
